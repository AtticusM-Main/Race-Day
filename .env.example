# Copy this file to ".env" (which git ignores) and fill in the values.

# Password for the SQL Server "sa" account (needs upper and lower case letters, digits and a symbol).
SQL_SA_PASSWORD=ChangeMe-Str0ng!Passw0rd

# Secret used to sign login tokens. Use a long random value (32+ characters).
JWT_KEY=replace-with-a-long-random-secret-at-least-32-chars

# Connection string of your Azure Storage account (Azure portal > Storage account > Access keys).
# Leave empty to run without image uploads; uploads then show a friendly "storage unavailable" message.
AZURE_STORAGE_CONNECTION_STRING=

# Optional: blob container used for banners and profile pictures.
BLOB_CONTAINER_NAME=raceday-images
