@model List<EnrolmentDto>
@{
    ViewData["Title"] = "My enrolments";
}
<div class="container pb-5">
    <div class="rd-page-head">
        <div>
            <h1>My enrolments</h1>
            <p>Every event you have entered, with its current status.</p>
        </div>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Find more events</a>
    </div>

    @if (ViewData["LoadError"] is string loadError)
    {
        <div class="alert alert-danger" role="alert">@loadError</div>
    }
    else if (Model.Count == 0)
    {
        <partial name="_EmptyState" model='("🎽", "No enrolments yet", "Browse the upcoming events and enter your first race.")' />
    }
    else
    {
        <div class="rd-card rd-table-wrap">
            <div class="table-responsive">
                <table class="table table-hover rd-table">
                    <thead>
                        <tr>
                            <th scope="col">Event</th>
                            <th scope="col">Date</th>
                            <th scope="col">Category</th>
                            <th scope="col">Entered on</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model)
                        {
                            var passed = e.EventDate < DateTime.Now;
                            <tr>
                                <td><a class="fw-semibold" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a></td>
                                <td>@e.EventDate.ToString("ddd d MMM yyyy")</td>
                                <td>@e.CategoryName</td>
                                <td>@e.EnrolmentDate.ToString("d MMM yyyy")</td>
                                <td>
                                    @if (e.ResultId is not null)
                                    {
                                        <span class="rd-status rd-status-completed">Completed</span>
                                    }
                                    else
                                    {
                                        <partial name="_StatusBadge" model="e.Status" />
                                    }
                                </td>
                                <td class="text-end">
                                    @if (e.ResultId is null && !passed)
                                    {
                                        <form asp-action="Cancel" asp-route-id="@e.EnrolmentId" method="post" class="d-inline" data-confirm="Cancel your entry for @e.EventName?">
                                            <button type="submit" class="btn btn-outline-dark btn-sm">Cancel entry</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
