@model EventEnrolmentsViewModel
@{
    ViewData["Title"] = "Enrolments";
    var confirmed = Model.Enrolments.Count(e => e.Status == EnrolmentStatus.Confirmed);
    var pending = Model.Enrolments.Count - confirmed;
}
<div class="container pb-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="OrganiserEvents" asp-action="Index">Manage events</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Event.Name</li>
        </ol>
    </nav>

    <div class="rd-page-head">
        <div>
            <h1>Enrolments</h1>
            <p>@Model.Event.Name &middot; @Model.Event.EventDate.ToString("d MMM yyyy")</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-dark" asp-controller="OrganiserCategories" asp-action="Index" asp-route-eventId="@Model.Event.EventId">Categories</a>
            <a class="btn btn-primary" asp-controller="OrganiserResults" asp-action="Index" asp-route-eventId="@Model.Event.EventId">Enter results</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-4"><div class="rd-card rd-stat"><div class="rd-stat-value">@Model.Enrolments.Count</div><div class="rd-stat-label">Total entries</div></div></div>
        <div class="col-sm-4"><div class="rd-card rd-stat"><div class="rd-stat-value">@confirmed</div><div class="rd-stat-label">Confirmed</div></div></div>
        <div class="col-sm-4"><div class="rd-card rd-stat"><div class="rd-stat-value">@pending</div><div class="rd-stat-label">Pending</div></div></div>
    </div>

    @if (Model.Enrolments.Count == 0)
    {
        <partial name="_EmptyState" model='("📭", "No entries yet", "Participants who enter this event will appear here.")' />
    }
    else
    {
        <div class="rd-card rd-table-wrap">
            <div class="table-responsive">
                <table class="table table-hover rd-table">
                    <thead>
                        <tr>
                            <th scope="col">Participant</th>
                            <th scope="col">Email</th>
                            <th scope="col">Category</th>
                            <th scope="col">Entered on</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Enrolments)
                        {
                            <tr>
                                <td class="fw-semibold">@e.ParticipantName</td>
                                <td>@e.ParticipantEmail</td>
                                <td>@e.CategoryName</td>
                                <td>@e.EnrolmentDate.ToString("d MMM yyyy")</td>
                                <td><partial name="_StatusBadge" model="e.Status" /></td>
                                <td class="text-end">
                                    <form asp-action="SetStatus" asp-route-eventId="@Model.Event.EventId" asp-route-id="@e.EnrolmentId" method="post" class="d-inline">
                                        @if (e.Status == EnrolmentStatus.Pending)
                                        {
                                            <input type="hidden" name="status" value="Confirmed" />
                                            <button type="submit" class="btn btn-primary btn-sm">Confirm</button>
                                        }
                                        else
                                        {
                                            <input type="hidden" name="status" value="Pending" />
                                            <button type="submit" class="btn btn-outline-dark btn-sm">Mark pending</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
