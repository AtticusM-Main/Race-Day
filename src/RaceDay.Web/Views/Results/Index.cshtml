@model List<ResultDto>
@{
    ViewData["Title"] = "My results";
    var podiums = Model.Count(r => r.Position is >= 1 and <= 3);
    var best = Model.Where(r => r.Position is not null).OrderBy(r => r.Position).FirstOrDefault();
}
<div class="container pb-5">
    <div class="rd-page-head">
        <div>
            <h1>My results</h1>
            <p>Your race history across every completed event.</p>
        </div>
    </div>

    @if (ViewData["LoadError"] is string loadError)
    {
        <div class="alert alert-danger" role="alert">@loadError</div>
    }
    else if (Model.Count == 0)
    {
        <partial name="_EmptyState" model='("🏅", "No results yet", "Results appear here once an organiser publishes them after your event.")' />
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-sm-4">
                <div class="rd-card rd-stat"><div class="rd-stat-value">@Model.Count</div><div class="rd-stat-label">Races completed</div></div>
            </div>
            <div class="col-sm-4">
                <div class="rd-card rd-stat"><div class="rd-stat-value">@podiums</div><div class="rd-stat-label">Podium finishes</div></div>
            </div>
            <div class="col-sm-4">
                <div class="rd-card rd-stat">
                    <div class="rd-stat-value">@(best?.Position is int p ? Formatting.Ordinal(p) : "-")</div>
                    <div class="rd-stat-label">Best position</div>
                </div>
            </div>
        </div>

        <div class="rd-card rd-table-wrap">
            <div class="table-responsive">
                <table class="table table-hover rd-table">
                    <thead>
                        <tr>
                            <th scope="col">Event</th>
                            <th scope="col">Date</th>
                            <th scope="col">Category</th>
                            <th scope="col">Finish time</th>
                            <th scope="col">Position</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@r.EventName</td>
                                <td>@r.EventDate.ToString("d MMM yyyy")</td>
                                <td>@r.CategoryName</td>
                                <td><span class="fw-semibold">@Formatting.FinishTime(r.FinishTime)</span></td>
                                <td>
                                    @if (r.Position is int position)
                                    {
                                        @* The total only counts results recorded in RaceDay, so it is hidden when it is lower than the position. *@
                                        <span class="rd-position">@Formatting.Ordinal(position) @if (r.TotalFinishers >= position) {<small>out of @r.TotalFinishers @(r.TotalFinishers == 1 ? "finisher" : "finishers")</small>}</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not ranked</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
