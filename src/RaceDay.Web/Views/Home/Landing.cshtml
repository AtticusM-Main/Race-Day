@{
    ViewData["Title"] = "Home";
}
<section class="rd-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <p class="rd-display text-uppercase fw-bold mb-2" style="color: var(--rd-yellow); letter-spacing: .15em;">Runs &middot; Walks &middot; Rides</p>
                <h1>Your next <em>finish line</em> starts here.</h1>
                <p class="lead mt-3">RaceDay connects event organisers and participants. Find a race, pick your category, enter in seconds and see your results the moment they are published.</p>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">Get started</a>
                    <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Log in</a>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="rd-stripe"></div>

<div class="container py-5">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="rd-card h-100">
                <div class="rd-card-body">
                    <span class="rd-type-badge">Participants</span>
                    <h2 class="mt-3">Race with confidence</h2>
                    <ul class="mb-0">
                        <li>Browse upcoming events and filter by type, date or location</li>
                        <li>Enter an event and choose your category in one step</li>
                        <li>Track your enrolments and personal race history</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="rd-card h-100">
                <div class="rd-card-body">
                    <span class="rd-type-badge">Organisers</span>
                    <h2 class="mt-3">Run a smoother event</h2>
                    <ul class="mb-0">
                        <li>Create events with banners, categories and entry limits</li>
                        <li>See who has entered and confirm their places</li>
                        <li>Capture finish times and publish results</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
