@model LoginRequest
@{
    ViewData["Title"] = "Log in";
}
<div class="container">
    <div class="rd-card rd-auth-card">
        <div class="rd-card-body">
            <h1 class="mb-1">Log in</h1>
            <p class="text-muted">Welcome back. Your next race is waiting.</p>

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100" data-busy="Logging in...">Log in</button>
            </form>

            <hr />
            <p class="mb-0 text-center">New to RaceDay? <a asp-action="Register">Create an account</a></p>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
