@model EventDetailsViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = ev.Name;
}
<div class="container pb-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Events</a></li>
            <li class="breadcrumb-item active" aria-current="page">@ev.Name</li>
        </ol>
    </nav>

    <div class="rd-banner-xl mb-4">
        @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
        {
            <img src="@ev.BannerImageUrl" alt="Banner for @ev.Name" />
        }
        <span class="rd-type-badge position-absolute" style="left: 1.25rem; bottom: 1rem;">@ev.EventType</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <h1>@ev.Name</h1>
            <p class="text-muted">Organised by @ev.OrganiserName</p>

            <div class="row g-3 mb-4">
                <div class="col-sm-4">
                    <div class="rd-card rd-stat">
                        <div class="rd-stat-label">Date</div>
                        <div class="fw-semibold">@ev.EventDate.ToString("ddd d MMM yyyy")</div>
                        <div class="text-muted small">Starts @ev.EventDate.ToString("HH:mm")</div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="rd-card rd-stat">
                        <div class="rd-stat-label">Location</div>
                        <div class="fw-semibold">@ev.Location</div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="rd-card rd-stat">
                        <div class="rd-stat-label">Distance</div>
                        <div class="fw-semibold">@ev.Distance.ToString("0.##") km</div>
                    </div>
                </div>
            </div>

            <h2>About this event</h2>
            <p>@(string.IsNullOrWhiteSpace(ev.Description) ? "The organiser hasn't added a description yet." : ev.Description)</p>
        </div>

        <div class="col-lg-5">
            <div class="rd-card">
                <div class="rd-card-body">
                    <h2>Categories</h2>

                    @if (Model.MyEnrolment is { } mine)
                    {
                        <div class="alert alert-light border d-flex justify-content-between align-items-center" role="status">
                            <span>You are entered in <strong>@mine.CategoryName</strong></span>
                            <partial name="_StatusBadge" model="mine.Status" />
                        </div>
                        <a class="btn btn-outline-dark w-100" asp-controller="Enrolments" asp-action="Index">View my enrolments</a>
                    }
                    else if (ev.HasPassed)
                    {
                        <div class="alert alert-secondary" role="status">This event has already taken place, so entries are closed.</div>
                    }
                    else if (ev.Categories.Count == 0)
                    {
                        <div class="alert alert-secondary" role="status">The organiser hasn't opened any categories yet.</div>
                    }
                    else
                    {
                        <form asp-controller="Enrolments" asp-action="Create" method="post">
                            <input type="hidden" name="eventId" value="@ev.EventId" />
                            <fieldset>
                                <legend class="visually-hidden">Choose a category</legend>
                                <div class="list-group mb-3">
                                    @foreach (var category in ev.Categories)
                                    {
                                        <label class="list-group-item d-flex align-items-center gap-3 @(category.IsFull ? "text-muted" : "")">
                                            <input class="form-check-input mt-0" type="radio" name="categoryId" value="@category.CategoryId" required disabled="@category.IsFull" />
                                            <span class="flex-grow-1">
                                                <span class="fw-semibold d-block">@category.Name</span>
                                                <span class="small text-muted">
                                                    @(category.Distance is null ? "No set distance" : category.Distance.Value.ToString("0.##") + " km")
                                                    &middot;
                                                    @(category.MaxParticipants is null ? $"{category.EnrolledCount} entered" : $"{category.EnrolledCount} of {category.MaxParticipants} places taken")
                                                </span>
                                            </span>
                                            @if (category.IsFull)
                                            {
                                                <span class="rd-status rd-status-pending">Full</span>
                                            }
                                        </label>
                                    }
                                </div>
                            </fieldset>
                            <button type="submit" class="btn btn-primary w-100" data-busy="Entering...">Enter this event</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
