@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="container">
    <div class="rd-card rd-auth-card text-center">
        <div class="rd-card-body">
            <div class="rd-empty-icon" aria-hidden="true">&#128679;</div>
            <h1 class="mt-2">We hit a snag</h1>
            <p class="text-muted">Something went wrong on our side. It's not you. Please try again in a moment.</p>
            @if (Model?.ShowRequestId == true)
            {
                <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
            }
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
        </div>
    </div>
</div>
